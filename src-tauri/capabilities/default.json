{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for DGA Electronic Nose",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$RESOURCE/../Data/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$RESOURCE/../Data/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$RESOURCE/../Data/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$RESOURCE/../Data/**" }]
    }
  ]
}
